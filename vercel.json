{
  "buildCommand": "npm run build",
  "outputDirectory": "build",
  "routes": [
    {
      "src": "/(?<path>.*)",
      "has": [
        {
          "type": "header",
          "key": "accept",
          "value": ".*text/markdown.*"
        }
      ],
      "dest": "/api/entry?path=$path"
    },
    {
      "src": "/(.*)",
      "headers": {
        "Vary": "Accept"
      },
      "continue": true
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/developers.*",
      "dest": "/developers/index.html"
    },
    {
      "src": "/about.*",
      "dest": "/about/index.html"
    },
    {
      "src": "/contact.*",
      "dest": "/contact/index.html"
    },
    {
      "src": "/privacy.*",
      "dest": "/privacy/index.html"
    },
    {
      "src": "/pay/.*",
      "dest": "/index.html"
    },
    {
      "src": "/quickqr",
      "dest": "/index.html"
    },
    {
      "src": "/quick",
      "dest": "/index.html"
    },
    {
      "src": "/.*",
      "status": 404,
      "dest": "/404.html"
    }
  ]
}
